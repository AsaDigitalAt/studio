rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      // Allow any authenticated user to read user profiles.
      allow read: if request.auth != null;
      // Only allow a user to create or update their own profile.
      allow write: if request.auth != null && request.auth.uid == userId;
    }
    
    match /tagging_runs/{taggingRunId} {
      allow create: if request.auth != null && request.auth.uid == request.resource.data.createdBy;
      allow read, update, delete: if request.auth != null && request.auth.uid == resource.data.createdBy;
    }
  }
}
